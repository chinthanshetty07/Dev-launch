    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.31",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "@types/tar-fs": "^2.0.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
