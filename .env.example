# DevLaunch configuration (all optional; defaults in apps/backend/src/config)
DEVLAUNCH_CONTAINER_MEMORY_MB=1024
DEVLAUNCH_CONTAINER_CPUS=2
DEVLAUNCH_MAX_CONCURRENT_SESSIONS=1

# --- AI fallback (Phase 8) -------------------------------------------------
# Optional. Without a key DevLaunch plans deterministically and reports
# UNSUPPORTED_PROJECT for anything its 22 detectors do not recognise.
# Get one at https://console.groq.com — never commit the real value.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
