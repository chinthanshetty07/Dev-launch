PORT=5000
# The variable this service actually reads. Naming it is what lets DevLaunch inject the
# right one: a service reading MONGODB_URI finds nothing in MONGO_URI.
MONGODB_URI=mongodb://localhost:27017/fullstack
# The origin the browser will call from. Without it, CORS refuses every request.
CORS_ORIGIN=http://localhost:5173
# Declared with no value: the gate must ask for it, and the service must receive it.
APP_SECRET=
